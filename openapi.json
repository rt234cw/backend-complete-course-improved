{
  "openapi": "3.1.0",
  "info": {
    "title": "Movie Watchlist API",
    "version": "1.0.0",
    "description": "Movie watchlist REST API.\n\n**Authentication.** `POST /auth/login` sets two HttpOnly cookies and the browser sends them automatically, so \"Try it out\" works right after logging in on this page. Tokens are never returned in the response body.\n\n**Responses.** Success: `{ data }`, lists: `{ data, meta }`, errors: `{ error: { code, message, details? } }`.\n\n**Rate limits.** 300 requests per IP per 15 minutes overall; 10 per IP per 15 minutes on signup, login and refresh."
  },
  "servers": [
    {
      "url": "/api"
    }
  ],
  "tags": [
    {
      "name": "Auth",
      "description": "Sign up, sign in and session management"
    },
    {
      "name": "Movies",
      "description": "Shared movie catalog"
    },
    {
      "name": "Genres"
    },
    {
      "name": "Watchlist",
      "description": "The signed-in user's personal watchlist"
    },
    {
      "name": "System"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "System"
        ],
        "operationId": "healthCheck",
        "summary": "Liveness check",
        "responses": {
          "200": {
            "description": "The server is up",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "status": {
                          "type": "string",
                          "const": "ok"
                        }
                      },
                      "required": [
                        "status"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "data"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        }
      }
    },
    "/auth/signup": {
      "post": {
        "tags": [
          "Auth"
        ],
        "operationId": "signup",
        "summary": "Create an account and start a session",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignupRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Account created and signed in",
            "headers": {
              "Set-Cookie": {
                "required": true,
                "description": "`access_token` (Path=/api) and `refresh_token` (Path=/api/auth), both HttpOnly and SameSite=Strict",
                "schema": {
                  "type": "string",
                  "description": "`access_token` (Path=/api) and `refresh_token` (Path=/api/auth), both HttpOnly and SameSite=Strict"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Session"
                    }
                  },
                  "required": [
                    "data"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "operationId": "login",
        "summary": "Sign in",
        "description": "Rate limited per IP. After 5 failed attempts for the same email within 15 minutes, further attempts return 429 until the window expires.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Signed in",
            "headers": {
              "Set-Cookie": {
                "required": true,
                "description": "`access_token` (Path=/api) and `refresh_token` (Path=/api/auth), both HttpOnly and SameSite=Strict",
                "schema": {
                  "type": "string",
                  "description": "`access_token` (Path=/api) and `refresh_token` (Path=/api/auth), both HttpOnly and SameSite=Strict"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Session"
                    }
                  },
                  "required": [
                    "data"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        }
      }
    },
    "/auth/refresh": {
      "post": {
        "tags": [
          "Auth"
        ],
        "operationId": "refresh",
        "summary": "Rotate the refresh token and issue a new access token",
        "description": "The refresh token is single-use. Presenting one that was already rotated revokes every session in its family (reuse detection). Rate limited per IP, but requests without a refresh_token cookie are rejected with 401 before the rate limit, so anonymous visitors do not use up the login / signup limit.",
        "parameters": [
          {
            "in": "cookie",
            "name": "refresh_token",
            "schema": {
              "description": "Set by login / signup / refresh. Path=/api/auth, HttpOnly, SameSite=Strict",
              "type": "string"
            },
            "description": "Set by login / signup / refresh. Path=/api/auth, HttpOnly, SameSite=Strict"
          }
        ],
        "responses": {
          "200": {
            "description": "New tokens issued",
            "headers": {
              "Set-Cookie": {
                "required": true,
                "description": "`access_token` (Path=/api) and `refresh_token` (Path=/api/auth), both HttpOnly and SameSite=Strict",
                "schema": {
                  "type": "string",
                  "description": "`access_token` (Path=/api) and `refresh_token` (Path=/api/auth), both HttpOnly and SameSite=Strict"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Session"
                    }
                  },
                  "required": [
                    "data"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "tags": [
          "Auth"
        ],
        "operationId": "logout",
        "summary": "Revoke the refresh token and clear auth cookies",
        "parameters": [
          {
            "in": "cookie",
            "name": "refresh_token",
            "schema": {
              "description": "Set by login / signup / refresh. Path=/api/auth, HttpOnly, SameSite=Strict",
              "type": "string"
            },
            "description": "Set by login / signup / refresh. Path=/api/auth, HttpOnly, SameSite=Strict"
          }
        ],
        "responses": {
          "204": {
            "description": "Signed out (also returned when there was no session)"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        }
      }
    },
    "/auth/me": {
      "get": {
        "tags": [
          "Auth"
        ],
        "operationId": "getCurrentUser",
        "summary": "Get the signed-in user",
        "security": [
          {
            "cookieAuth": []
          },
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "The signed-in user",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/User"
                    }
                  },
                  "required": [
                    "data"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        }
      }
    },
    "/movies": {
      "get": {
        "tags": [
          "Movies"
        ],
        "operationId": "listMovies",
        "summary": "List movies",
        "description": "Paginated. Ties in the sort field are broken by id, so pages are stable.",
        "parameters": [
          {
            "in": "query",
            "name": "page",
            "schema": {
              "default": 1,
              "type": "integer",
              "minimum": 1,
              "maximum": 10000
            }
          },
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "default": 20,
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          },
          {
            "in": "query",
            "name": "search",
            "schema": {
              "description": "Case-insensitive substring match on title",
              "example": "horizon",
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "description": "Case-insensitive substring match on title"
          },
          {
            "in": "query",
            "name": "genre",
            "schema": {
              "description": "Genre name, case-insensitive exact match",
              "example": "Sci-Fi",
              "type": "string",
              "minLength": 1,
              "maxLength": 50
            },
            "description": "Genre name, case-insensitive exact match"
          },
          {
            "in": "query",
            "name": "year",
            "schema": {
              "description": "Release year",
              "example": 2019,
              "type": "integer",
              "minimum": 1888,
              "maximum": 2031
            },
            "description": "Release year"
          },
          {
            "in": "query",
            "name": "sort",
            "schema": {
              "default": "createdAt",
              "type": "string",
              "enum": [
                "title",
                "releaseYear",
                "createdAt"
              ]
            }
          },
          {
            "in": "query",
            "name": "order",
            "schema": {
              "default": "desc",
              "type": "string",
              "enum": [
                "asc",
                "desc"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A page of movies",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Movie"
                      }
                    },
                    "meta": {
                      "$ref": "#/components/schemas/PaginationMeta"
                    }
                  },
                  "required": [
                    "data",
                    "meta"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        }
      }
    },
    "/movies/{id}": {
      "get": {
        "tags": [
          "Movies"
        ],
        "operationId": "getMovie",
        "summary": "Get a movie",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "schema": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "The movie",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Movie"
                    }
                  },
                  "required": [
                    "data"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        }
      }
    },
    "/genres": {
      "get": {
        "tags": [
          "Genres"
        ],
        "operationId": "listGenres",
        "summary": "List all genres",
        "responses": {
          "200": {
            "description": "All genres, sorted by name",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Genre"
                      }
                    }
                  },
                  "required": [
                    "data"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        }
      }
    },
    "/watchlist": {
      "get": {
        "tags": [
          "Watchlist"
        ],
        "operationId": "listWatchlist",
        "summary": "List the signed-in user's watchlist",
        "description": "Newest first. Each item includes the full movie.",
        "security": [
          {
            "cookieAuth": []
          },
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "query",
            "name": "page",
            "schema": {
              "default": 1,
              "type": "integer",
              "minimum": 1,
              "maximum": 10000
            }
          },
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "default": 20,
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          },
          {
            "in": "query",
            "name": "status",
            "schema": {
              "type": "string",
              "enum": [
                "PLANNED",
                "WATCHING",
                "COMPLETED",
                "DROPPED"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A page of watchlist items",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/WatchlistItemWithMovie"
                      }
                    },
                    "meta": {
                      "$ref": "#/components/schemas/PaginationMeta"
                    }
                  },
                  "required": [
                    "data",
                    "meta"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        }
      },
      "post": {
        "tags": [
          "Watchlist"
        ],
        "operationId": "addToWatchlist",
        "summary": "Add a movie to the watchlist",
        "security": [
          {
            "cookieAuth": []
          },
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddToWatchlistRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Added. `status` defaults to PLANNED",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/WatchlistItem"
                    }
                  },
                  "required": [
                    "data"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        }
      }
    },
    "/watchlist/ids": {
      "get": {
        "tags": [
          "Watchlist"
        ],
        "operationId": "listWatchlistIds",
        "summary": "List the signed-in user's watchlist as ids",
        "description": "Every item, unpaginated, with only `id`, `movieId` and `status`. Meant for the client to mark which movies are already in the watchlist.",
        "security": [
          {
            "cookieAuth": []
          },
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "All of the user's items, newest first",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/WatchlistId"
                      }
                    }
                  },
                  "required": [
                    "data"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        }
      }
    },
    "/watchlist/{id}": {
      "patch": {
        "tags": [
          "Watchlist"
        ],
        "operationId": "updateWatchlistItem",
        "summary": "Update status, rating or notes",
        "security": [
          {
            "cookieAuth": []
          },
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "schema": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "required": true
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateWatchlistItemRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Item updated",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/WatchlistItem"
                    }
                  },
                  "required": [
                    "data"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        }
      },
      "delete": {
        "tags": [
          "Watchlist"
        ],
        "operationId": "removeFromWatchlist",
        "summary": "Remove an item from the watchlist",
        "security": [
          {
            "cookieAuth": []
          },
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "schema": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "required": true
          }
        ],
        "responses": {
          "204": {
            "description": "Item removed"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "SignupRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50,
            "example": "Demo User"
          },
          "email": {
            "description": "Trimmed and lowercased before use",
            "example": "demo@example.com",
            "type": "string"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "description": "8 characters to 72 bytes (UTF-8), the bcrypt input limit",
            "example": "correct-horse-battery"
          }
        },
        "required": [
          "name",
          "email",
          "password"
        ]
      },
      "LoginRequest": {
        "type": "object",
        "properties": {
          "email": {
            "description": "Trimmed and lowercased before use",
            "example": "demo@example.com",
            "type": "string"
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "example": "correct-horse-battery"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "AddToWatchlistRequest": {
        "type": "object",
        "properties": {
          "movieId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "status": {
            "type": "string",
            "enum": [
              "PLANNED",
              "WATCHING",
              "COMPLETED",
              "DROPPED"
            ]
          },
          "rating": {
            "example": 8,
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          },
          "notes": {
            "example": "Rewatch with friends",
            "type": "string"
          }
        },
        "required": [
          "movieId"
        ]
      },
      "UpdateWatchlistItemRequest": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "PLANNED",
              "WATCHING",
              "COMPLETED",
              "DROPPED"
            ]
          },
          "rating": {
            "example": 8,
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          },
          "notes": {
            "example": "Rewatch with friends",
            "type": "string"
          }
        },
        "description": "At least one field is required"
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "description": "Stable, machine-readable error code",
                "example": "VALIDATION_ERROR"
              },
              "message": {
                "type": "string",
                "example": "Request validation failed"
              },
              "details": {
                "description": "Only present on VALIDATION_ERROR",
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "location": {
                      "type": "string",
